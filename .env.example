# ==============================================================================
# RepoPilot AI - Production OAuth & Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in your OAuth Client IDs and Secrets from Google Cloud & GitHub Developer Settings.

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------------------
# GitHub OAuth Configuration
# ------------------------------------------------------------------------------
# Create in GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# (For linking connected accounts, GitHub callback route handles both /api/auth/callback/github and /api/github/callback)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# ------------------------------------------------------------------------------
# Session & Token Encryption Secret
# ------------------------------------------------------------------------------
# Must be at least 32 characters or 64 hex characters used for AES-256-GCM token encryption
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Database Configuration (Optional / Extensible)
# ------------------------------------------------------------------------------
DATABASE_URL=file:./.data/repopilot_db.json
