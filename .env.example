# ==============================================================================
# RepoPilot AI - Production OAuth & Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in your OAuth Client IDs and Secrets from Google Cloud & GitHub Developer Settings.

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Primary Autonomous Engineering Intelligence)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash


# ------------------------------------------------------------------------------
# Alternative LLM Provider Configuration (Optional Fallbacks)
# ------------------------------------------------------------------------------
# OpenAI (Optional):
# OPENAI_API_KEY=sk-proj-your-openai-api-key
# OPENAI_MODEL=gpt-4o

# Anthropic (Optional):
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Primary Autonomous Engineering Intelligence)
# ------------------------------------------------------------------------------
# Get your Gemini API Key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Alternative LLM Provider Configuration (Optional Fallbacks)
# ------------------------------------------------------------------------------
# OpenAI (Optional):
# OPENAI_API_KEY=sk-proj-your-openai-api-key
# OPENAI_MODEL=gpt-4o

# Anthropic (Optional):
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Google OAuth Configuration
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------------------
# GitHub OAuth Configuration
# ------------------------------------------------------------------------------
# Create in GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# ------------------------------------------------------------------------------
# Session & Token Encryption Secret
# ------------------------------------------------------------------------------
# Must be at least 32 characters or 64 hex characters used for AES-256-GCM token encryption
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Database & Job Queue Configuration
# ------------------------------------------------------------------------------
# Default: File-backed atomic JSON store (.data/repopilot_db.json)
DATABASE_URL=file:./.data/repopilot_db.json
# PostgreSQL Production (Optional): postgresql://user:password@host:5432/repopilot
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Isolated Sandbox Worker Configuration (Optional Distributed Execution)
# ------------------------------------------------------------------------------
# Default: Local secure process isolation in .workspaces/repair-jobs
# Distributed container worker (Optional):
# SANDBOX_WORKER_URL=http://localhost:8080
# SANDBOX_WORKER_SECRET=your-sandbox-shared-secret
# KEEP_WORKSPACES=false
